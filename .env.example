# Modal Cloud Credentials
# Obtain these by running `modal setup` or visiting https://modal.com/settings/tokens
# NEVER commit real values — copy this file to .env.local and fill it in.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face Token (for downloading gated model weights like Ideogram 4 or Flux)
# Obtain from https://huggingface.co/settings/tokens
# Also stored as a Modal Secret named `huggingface-secret` (see README).
HF_TOKEN=

# Optional: local folder of *.safetensors files to sync into the Modal
# `lora-outputs` volume via /api/loras. Leave empty for cloud-only listing.
LORA_LOCAL_DIR=

